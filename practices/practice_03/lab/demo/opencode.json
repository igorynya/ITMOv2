{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen2.5:1.5b-instruct",
  "small_model": "ollama/qwen2.5:1.5b-instruct",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama local",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen2.5:1.5b-instruct": {
          "name": "Qwen2.5 1.5B instruct",
          "limit": {
            "context": 8192,
            "output": 1024
          }
        }
      }
    }
  },
  "agent": {
    "local-guide-a": {
      "description": "Read-only local repository assistant (Prompt A)",
      "mode": "primary",
      "prompt": "{file:./repo-system.txt}",
      "steps": 8,
      "permission": {"*": "deny", "read": "allow", "glob": "allow"}
    },
    "local-guide-b": {
      "description": "Read-only local repository assistant (Prompt B)",
      "mode": "primary",
      "prompt": "{file:./repo-system-b.txt}",
      "steps": 8,
      "permission": {"*": "deny", "read": "allow", "glob": "allow"}
    }
  }
}
