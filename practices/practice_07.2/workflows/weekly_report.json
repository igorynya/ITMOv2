    {
      "parameters": {
        "jsCode": "// Текущая неделя из первого Code node\nconst cur = $('Code in JavaScript').first().json;\nconst week = $now.toFormat(\"kkkk-'W'WW\");   // например 2026-W47\n\nconst current = {\n  week,\n  created: cur.created,\n  closed: cur.closed,\n  prs: cur.prs,\n  backlog: cur.backlog,\n  bug: cur.byType['bug'] ?? 0,\n  task: cur.byType['task'] ?? 0,\n  future: cur.byType['future'] ?? 0,\n  needs_triage: cur.byType['needs-triage'] ?? 0,\n  other: cur.byType['other'] ?? 0,\n};\n\n// Прошлая неделя: последняя запись в таблице, где week не равна текущей\nconst rows = $input.all().map(i => i.json).filter(r => r.week && r.week !== week);\nrows.sort((a, b) => String(a.week).localeCompare(String(b.week)));\nconst prev = rows.length ? rows[rows.length - 1] : null;\n\nconst labels = {\n  created: 'Новых Issues',\n  closed: 'Закрыто Issues',\n  prs: 'Pull requests',\n  backlog: 'Открытых сейчас',\n  bug: 'bug',\n  task: 'task',\n  future: 'future',\n  needs_triage: 'needs-triage',\n  other: 'other',\n};\n\nconst deltas = {};\nfor (const k of Object.keys(labels)) {\n  deltas[k] = prev ? Number(current[k]) - Number(prev[k] ?? 0) : null;\n}\nconst fmt = d => d === null ? '—' : d > 0 ? `+${d}` : `${d}`;\n\nconst row = k => `<tr>\n  <td>${labels[k]}</td>\n  <td>${current[k]}</td>\n  <td>${prev ? (prev[k] ?? 0) : '—'}</td>\n  <td>${fmt(deltas[k])}</td>\n</tr>`;\n\nconst table = keys => `<table border=\"1\" cellpadding=\"6\">\n  <tr><th>Показатель</th><th>Эта неделя</th><th>Прошлая</th><th>Δ</th></tr>\n  ${keys.map(row).join('')}\n</table>`;\n\nconst authors = Object.entries(cur.byAuthor)\n  .map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('');\n\nconst html = `<h2>Статистика Issues за неделю ${week}</h2>\n<p>Сравнение с ${prev ? prev.week : 'прошлой неделей (данных нет)'}</p>\n<h3>Общие показатели</h3>${table(['created', 'closed', 'prs', 'backlog'])}\n<h3>По типам</h3>${table(['bug', 'task', 'future', 'needs_triage', 'other'])}\n<h3>По авторам</h3><table border=\"1\" cellpadding=\"6\">${authors}</table>`;\n\n// Текст для AI-комментария\nconst summary = Object.keys(labels)\n  .map(k => `${labels[k]}: ${current[k]} (было ${prev ? (prev[k] ?? 0) : 'нет данных'}, Δ ${fmt(deltas[k])})`)\n  .join('\\n');\n\nreturn [{ json: { ...current, prevWeek: prev ? prev.week : null, deltas, summary, html } }];"
      },
