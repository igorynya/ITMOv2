      "name": "Merge"
    },
    {
      "parameters": {
        "jsCode": "const since = new Date(Date.now() - 7 * 24 * 3600 * 1000);\nconst notPr = i => i.number && !i.pull_request;\n\n// Данные из четырёх запросов\nconst created = $('New issues').all().map(i => i.json)\n  .filter(i => notPr(i) && new Date(i.created_at) >= since);\nconst closed = $('Closed issues').all().map(i => i.json)\n  .filter(i => notPr(i) && i.closed_at && new Date(i.closed_at) >= since);\nconst prCount = $('pull requests').all().map(i => i.json)\n  .filter(p => p.number && new Date(p.created_at) >= since).length;\nconst backlog = $('Open issues').all().map(i => i.json).filter(notPr).length;\n\n// Группировка новых Issues по типу (по лейблу) и по автору\nconst types = ['bug', 'task', 'future', 'needs-triage'];\nconst byType = Object.fromEntries([...types, 'other'].map(t => [t, 0]));\nconst byAuthor = {};\nfor (const i of created) {\n  const names = i.labels.map(l => l.name);\n  const t = types.find(t => names.includes(t)) ?? 'other';\n  byType[t]++;\n  byAuthor[i.user.login] = (byAuthor[i.user.login] ?? 0) + 1;\n}\n\n// HTML-письмо\nconst rows = obj => Object.entries(obj)\n  .map(([k, v]) => `<tr><td>${k}</td><td>${v}</td></tr>`).join('');\n\nconst html = `<h2>Статистика Issues за неделю</h2>\n<p>Новых: ${created.length}, закрыто: ${closed.length}, PR: ${prCount}, открытых сейчас: ${backlog}</p>\n<h3>По типам</h3>\n<table border=\"1\" cellpadding=\"6\">${rows(byType)}</table>\n<h3>По авторам</h3>\n<table border=\"1\" cellpadding=\"6\">${rows(byAuthor)}</table>`;\n\nreturn [{\n  json: {\n    created: created.length,\n    closed: closed.length,\n    prs: prCount,\n    backlog,\n    byType,\n    byAuthor,\n    html,\n  },\n}];"
      },
